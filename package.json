{
  "name": "typescript-auth-app",
  "version": "1.0.0",
  "description": "Minimal TypeScript authentication system with Prisma & SQLite",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/auth.ts",
    "start": "tsx src/auth.ts",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset"
  },
  "keywords": [
    "typescript",
    "auth",
    "prisma",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15"
  }
}
